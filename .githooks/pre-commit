#!/bin/sh
set -eu
node scripts/check-public-repository.mjs --staged
scanner=$(git config --local --get shredit.gitleaksPath || true)
if [ -z "$scanner" ] && command -v gitleaks >/dev/null 2>&1; then
  scanner=gitleaks
fi
if [ -n "$scanner" ]; then
  "$scanner" git --pre-commit --staged --redact=100 --no-banner --no-color --ignore-gitleaks-allow --timeout 60
elif [ "$(git config --local --get shredit.requireGitleaks || true)" = "true" ]; then
  echo "Commit blocked: the required independent secret scanner is unavailable." >&2
  exit 1
fi
